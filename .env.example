# Recall Picks — copy to .env and fill in. NEVER commit .env or any real key.
# PORT=3000
# SUI_ADDRESS=0x...  (optional: Sui address whose balance/transactions anchor the pick receipt)
# TATUM_API_KEY=   (from https://dashboard.tatum.io — Create API Key; Account_ID is bottom-left of dashboard)
# MEMWAL_ACCOUNT_ID=0x...  (Walrus Memory dashboard -> your agent's Sui object id)
# MEMWAL_PRIVATE_KEY=  (Walrus Memory dashboard -> Delegate keys -> private key, Ed25519 hex. Server-side ONLY.)
# MEMWAL_AGENT_ID=  (public key from Walrus Memory dashboard -> Delegate keys; 64 hex chars. Needed for the submission form.)
